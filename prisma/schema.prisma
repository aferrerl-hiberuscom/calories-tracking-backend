generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IngredientSource {
  VISIBLE
  INFERRED
  MANUAL
  ESTIMATED_GENERIC
  CONSOLIDATED
  MISSING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  meals     Meal[]
  createdAt DateTime @default(now())
}

model Meal {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealDate       DateTime
  status         String
  idempotencyKey String?
  ingredients    Ingredient[]
  nutrition      NutritionalData?
  image          Image?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, mealDate])
  @@index([userId])
}

model Ingredient {
  id                 String          @id @default(uuid())
  mealId             String
  meal               Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name               String          @db.VarChar(120)
  quantityG          Float
  source             IngredientSource
  confidence         Float?
  quantitySuspicious Boolean         @default(false)
  cookingMethod      String?         @db.VarChar(20)
  caloriesKcal       Float           @default(0)
  carbsG             Float           @default(0)
  proteinG           Float           @default(0)
  fatG               Float           @default(0)
  // Feature 008 — nutritional calculation fields
  nutritionSuspicious Boolean        @default(false)
  allergen           Boolean         @default(false)
  allergenList       String[]        @default([])
  dietaryType        String?         @db.VarChar(20)
  discrepancyDetected Boolean        @default(false)
  aiCaloriesKcal     Float?
  dbCaloriesKcal     Float?

  @@index([mealId])
  @@index([source])
  @@index([confidence])
  @@map("meal_ingredients")
}

model NutritionalData {
  id           String @id @default(uuid())
  mealId       String @unique
  meal         Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  totalWeightG Float
}

model Image {
  id         String   @id @default(uuid())
  mealId     String   @unique
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  sizeBytes  Int?
  createdAt  DateTime @default(now())
}

model NutritionalReference {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(120)
  category          String   @db.VarChar(60)
  caloriesPer100g   Float
  proteinPer100g    Float
  carbsPer100g      Float
  fatPer100g        Float
  aliases           String[]

  @@index([name])
  @@map("nutritional_reference")
}

