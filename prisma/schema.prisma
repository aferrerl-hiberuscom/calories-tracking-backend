generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IngredientSource {
  VISIBLE
  INFERRED
  MANUAL
  ESTIMATED_GENERIC
  CONSOLIDATED
  MISSING
  // Feature 026 (contract 013 v2.2.0, A-013-06) — ingredient whose macros come
  // from a Product resolved by barcode; validated like MANUAL (defined values).
  PRODUCT
}

// Feature 026 — origin of a Product's nutritional data (D-BAR-07): OFF is the
// only source that can be born verified; user contributions start unverified.
enum ProductSource {
  OFF
  USER_LABEL
  MANUAL
}

// Evolution ui_redesign_brote (contracts 013/014 v2.x) — meal type inferred
// from the local hour of meal_date at save time; editable afterwards in B3.
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  // Feature 001 — non-recoverable credential hash. Nullable so pre-existing
  // rows (created before auth) remain valid; users without a hash cannot sign in.
  passwordHash  String?
  // Evolution ui_redesign_brote (022 v1.3) — display name for the «Hola, {nombre}»
  // header; nullable, frontend falls back to the email local part.
  name          String?        @db.VarChar(120)
  meals         Meal[]
  refreshTokens RefreshToken[]
  nutritionGoal NutritionGoal?
  // Feature 027 — reusable dishes are PER USER (D-MULTI-06), unlike Products.
  dishes        Dish[]
  createdAt     DateTime       @default(now())
}

// Feature 025 — daily nutrition goals (one row per user; defaults are NOT
// persisted, they are served with is_default=true until the first edit).
model NutritionGoal {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caloriesKcalTarget Int
  proteinGTarget     Int
  carbsGTarget       Int
  fatGTarget         Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("nutrition_goals")
}

// Feature 001 — opaque refresh tokens stored as a one-way hash to support
// renewal, rotation and revocation. The raw token is never persisted.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Meal {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Evolution ui_redesign_brote (013/014 v2.x) — dish name (backfilled with
  // "Comida") and meal type (backfilled by hour bands from mealDate).
  name           String           @db.VarChar(120)
  mealType       MealType
  mealDate       DateTime
  status         String
  idempotencyKey String?
  ingredients    Ingredient[]
  nutrition      NutritionalData?
  image          Image?
  // Evolution favoritos_mis_platos — back-relation to the favorite Dish (if the
  // meal has been added to «Mis platos»). is_favorite = favoriteDish != null.
  favoriteDish   Dish?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, mealDate])
  @@index([userId])
}

model Ingredient {
  id                 String          @id @default(uuid())
  mealId             String
  meal               Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name               String          @db.VarChar(120)
  quantityG          Float
  source             IngredientSource
  confidence         Float?
  quantitySuspicious Boolean         @default(false)
  cookingMethod      String?         @db.VarChar(20)
  caloriesKcal       Float           @default(0)
  carbsG             Float           @default(0)
  proteinG           Float           @default(0)
  fatG               Float           @default(0)
  // Feature 008 — nutritional calculation fields
  nutritionSuspicious Boolean        @default(false)
  allergen           Boolean         @default(false)
  allergenList       String[]        @default([])
  dietaryType        String?         @db.VarChar(20)
  discrepancyDetected Boolean        @default(false)
  aiCaloriesKcal     Float?
  dbCaloriesKcal     Float?

  @@index([mealId])
  @@index([source])
  @@index([confidence])
  @@map("meal_ingredients")
}

model NutritionalData {
  id           String @id @default(uuid())
  mealId       String @unique
  meal         Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  caloriesKcal Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  totalWeightG Float
}

model Image {
  id         String   @id @default(uuid())
  mealId     String   @unique
  meal       Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  sizeBytes  Int?
  createdAt  DateTime @default(now())
}

// Feature 026 — packaged products resolved by barcode (evolution
// escaneo_codigo_barras). Global entities (not per-user) keyed by the
// normalized barcode (D-BAR-10: EAN-13/EAN-8, UPC-A left-padded with 0).
// createdByUserId is internal traceability only — never exposed via the API.
model Product {
  id               String        @id @default(uuid())
  barcode          String        @unique
  name             String        @db.VarChar(120)
  brand            String?       @db.VarChar(120)
  caloriesKcal100g Float
  proteinG100g     Float
  carbsG100g       Float
  fatG100g         Float
  servingSizeG     Float?
  servingLabel     String?       @db.VarChar(60)
  source           ProductSource
  verified         Boolean       @default(false)
  createdByUserId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("products")
}

// Feature 027 (evolution plato_multiescaneo) — reusable dish composed of
// scanned products. Strictly per-user (D-MULTI-06): every query MUST filter
// by userId; there is no global read surface in v1 (D-MULTI-08).
model Dish {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String           @db.VarChar(120)
  ingredients DishIngredient[]
  // Evolution favoritos_mis_platos — links a favorite dish to its source meal.
  // Nullable + unique (at most one favorite Dish per meal, BR-028-11); SetNull
  // so deleting the meal keeps the favorite in «Mis platos» (BR-028-12).
  sourceMealId String?         @unique
  sourceMeal   Meal?           @relation(fields: [sourceMealId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@map("dishes")
}

// Snapshot of the composition as confirmed in A6 (macros frozen at save time);
// productBarcode is an informative reference to the global Product.
model DishIngredient {
  id             String  @id @default(uuid())
  dishId         String
  dish           Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name           String  @db.VarChar(120)
  productBarcode String?
  quantityG      Float
  caloriesKcal   Float
  proteinG       Float
  carbsG         Float
  fatG           Float

  @@index([dishId])
  @@map("dish_ingredients")
}

model NutritionalReference {
  id                String   @id @default(uuid())
  name              String   @db.VarChar(120)
  category          String   @db.VarChar(60)
  caloriesPer100g   Float
  proteinPer100g    Float
  carbsPer100g      Float
  fatPer100g        Float
  aliases           String[]

  @@index([name])
  @@map("nutritional_reference")
}

